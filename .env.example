# TierTracker / DSU Spatial Platform Configuration

# Gateway HTTP Port (Default: 3000)
PORT=3000

# Server Host Binding (Default: 0.0.0.0)
HOST=0.0.0.0

# Google Maps Platform API Key (Optional Places Autocomplete enhancement)
GOOGLE_MAPS_API_KEY=

# Campus Wi-Fi Ingestion Interval (ms)
WIFI_TELEMETRY_INTERVAL_MS=8000

# Campus Wi-Fi Traffic Profile (NORMAL | PEAK | OFFPEAK)
WIFI_TRAFFIC_PROFILE=NORMAL
